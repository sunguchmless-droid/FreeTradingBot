# Copy this file to .env. Never commit your real .env file.
MT5_SYMBOL=EURUSD
MT5_TIMEFRAME=M15
MT5_BARS=300

# Keep false for the first run. Change to true only after reviewing the setup.
AUTO_DEMO_TRADING=false

# Execution safeguards are enforced in code: demo accounts only, max 1% risk,
# ATR-based stop-loss, 2:1 reward/risk target, and one open position per symbol.
